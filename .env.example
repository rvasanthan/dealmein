# Legacy Spring Boot/PostgreSQL backend only. The Firebase Functions runtime uses
# Secret Manager; do not put production secrets in this file.
POSTGRES_DB=dealmein
POSTGRES_USER=dealmein
POSTGRES_PASSWORD=change-me

APP_ADMIN_USERNAME=vasanth.ravindran@gmail.com
# BCrypt hash (keep the single quotes). Generate with:
#   pip install bcrypt && python3 -c "import bcrypt,getpass;print(bcrypt.hashpw(getpass.getpass().encode(),bcrypt.gensalt(10)).decode())"
APP_ADMIN_PASSWORD_HASH='$2b$10$replace-with-your-own-bcrypt-hash'
# At least 32 random characters, e.g. `openssl rand -base64 48`
APP_JWT_SECRET=replace-with-a-long-random-secret-of-32-plus-chars
APP_TOKEN_TTL_MINUTES=480
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_DEFAULT_RETAILER_TIMEZONE=America/New_York
APP_REPORTS_PER_HOUR=5
